-- Insertion sort over a fixed-size int array. Sorts [5, 2, 4, 6, 1, 3]
-- to [1, 2, 3, 4, 5, 6] in place, then returns a[2] (= 3) as the exit code.
int main() {
    mut arr[int] a := [5, 2, 4, 6, 1, 3];
    mut int i := 1;
    while i < len(a) {
        mut int j := i;
        while j > 0 {
            mut int prev := j - 1;
            if a[prev] > a[j] {
                mut int tmp := a[prev];
                a[prev] = a[j];
                a[j] = tmp;
                j = j - 1;
            } else {
                j = 0;
            }
        }
        i = i + 1;
    }
    return a[2];
}
