---
--- title: Euclidean GCD via recursion
--- description: Greatest common divisor with the standard recurrence: gcd(a, 0) = a; gcd(a, b) = gcd(b, a % b).
--- expected_output: |
---   14
--- tags: [recursion, modulo, algorithms]
---

int gcd(int a, int b) {
    if b == 0 { return a; } else { return gcd(b, a % b); }
}

int main() {
    print_int(gcd(98, 56));
    println();
    return 0;
}
