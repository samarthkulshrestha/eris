---
--- title: Insertion sort over a 6-element int array
--- description: Sort [5, 2, 4, 6, 1, 3] in place; print the sorted result, one element per line.
--- expected_output: |
---   1
---   2
---   3
---   4
---   5
---   6
--- tags: [arrays, sorting, algorithms]
---

int main() {
    mut arr[int] a := [5, 2, 4, 6, 1, 3];
    mut int i := 1;
    while i < len(a) {
        mut int j := i;
        while j > 0 {
            mut int prev := j - 1;
            if a[prev] > a[j] {
                mut int tmp := a[prev];
                a[prev] = a[j];
                a[j] = tmp;
                j = j - 1;
            } else {
                break;
            }
        }
        i = i + 1;
    }
    mut int k := 0;
    while k < len(a) {
        print_int(a[k]);
        println();
        k = k + 1;
    }
    return 0;
}
